---
import { contact } from '../data/site.js';

const VALUES = [
  { label: 'Termíny', desc: 'Dodržujeme domluvené termíny' },
  { label: 'Komunikace', desc: 'Přímý kontakt bez prostředníků' },
  { label: 'Materiály', desc: 'Pouze ověření dodavatelé' },
  { label: 'Záruka', desc: 'Garance kvality na provedené práce' },
];
---
<section id="o-nas" class="py-[var(--section-y)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">

      <!-- z-10: rozbalená bio karta přerůstá přes pravý sloupec -->
      <div class="relative z-10">
        <p class="eyebrow mb-2">Kdo jsme</p>
        <h2 class="h2 text-stone-950 mb-8">Rodinná firma<br />z Plzeňska</h2>
        <p class="font-body text-stone-600 leading-relaxed measure mb-5">
          Jsme stavební firma s více než 7 lety zkušeností. Zakládáme si na poctivé práci,
          dodržování termínů a přímé komunikaci se zákazníkem – bez prostředníků.
        </p>
        <p class="font-body text-stone-600 leading-relaxed measure mb-10">
          Každý projekt řídíme osobně od prvního setkání přes realizaci až po předání.
          Pracujeme pouze s ověřenými dodavateli a kvalitními materiály.
        </p>

        <div class="bio-wrapper">
          <div class="bio-card">
            <div class="bio-face">
              <div class="bio-avatar">
                <span class="font-display font-bold text-xl select-none">TŠ</span>
              </div>
              <div>
                <div class="font-display text-stone-950 text-xl font-semibold uppercase leading-tight">Tomáš Šedivý</div>
                <div class="font-body text-stone-500 text-sm mt-0.5">Jednatel · stavbyvedoucí</div>
              </div>
            </div>

            <div class="bio-details">
              <div class="bio-items">
                <a href={contact.phoneHref} class="bio-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700 flex-shrink-0" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16z"/>
                  </svg>
                  <span class="font-body text-stone-700 text-sm hover:text-brand-700 transition-colors">{contact.phone}</span>
                </a>
                <a href={`mailto:${contact.email}`} class="bio-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700 flex-shrink-0" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  <span class="font-body text-stone-700 text-sm hover:text-brand-700 transition-colors">{contact.email}</span>
                </a>
                <div class="bio-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700 flex-shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span class="font-body text-stone-700 text-sm">15+ let praxe v oboru</span>
                </div>
                <div class="bio-item">
                  <a href="#kontakt" class="btn btn-sm btn-primary">Kontaktovat →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <img
          src="/images/gallery/r/foto-85-800.webp"
          srcset="/images/gallery/r/foto-85-800.webp 800w, /images/gallery/r/foto-85-1600.webp 1600w"
          sizes="(min-width: 768px) 50vw, 100vw"
          alt="Tým Šedivák Stavby na staveništi"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          class="w-full h-48 md:h-64 object-cover"
        />
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          {VALUES.map((v) => (
            <div class="card-surface--flat border border-stone-200 p-3 md:p-4">
              <div class="font-display text-brand-700 uppercase text-sm tracking-wider mb-1">{v.label}</div>
              <div class="font-body text-stone-600 text-xs leading-relaxed">{v.desc}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
