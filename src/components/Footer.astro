---
import { ELEKTRO_URL, FACEBOOK_URL } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="bg-stone-950 border-t border-stone-800 py-8">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center">
      <img
        src="/images/logo-zlate-paticka-200.webp"
        srcset="/images/logo-zlate-paticka-200.webp 200w, /images/logo-zlate-paticka-400.webp 400w"
        sizes="48px"
        alt="Šedivák Stavby s.r.o"
        width="200"
        height="133"
        loading="lazy"
        decoding="async"
        class="h-8 w-auto"
      />
    </div>

    <p class="font-body text-stone-400 text-xs text-center">
      © {year} Šedivák stavby s.r.o. · IČO 22407570 · Dolní náměstí 46, 330 33 Město Touškov
    </p>

    <div class="flex gap-6">
      <a href="/zasady-ochrany-osobnich-udaju.html" class="font-body text-stone-400 hover:text-stone-200 text-xs transition-colors">Ochrana osobních údajů</a>
      <a href={FACEBOOK_URL} target="_blank" rel="noreferrer" class="font-body text-stone-400 hover:text-stone-200 text-xs transition-colors">Facebook</a>
      <a href={ELEKTRO_URL} target="_blank" rel="noreferrer" class="font-body text-stone-400 hover:text-brand-400 text-xs transition-colors">Šedivák Elektro →</a>
    </div>
  </div>
  <p class="max-w-6xl mx-auto px-6 mt-6 font-body text-stone-500 text-[11px] text-center">
    Web vytvořil Hrček|web
  </p>
</footer>
