---
// Plovoucí odkaz na poptávku – schovaný v hero a když je vidět kontakt
const { home = false } = Astro.props;
---
<a
  id="floating-cta"
  href={home ? '#kontakt' : '/#kontakt'}
  tabindex="-1"
  aria-hidden="true"
  style="box-shadow: var(--shadow-raised)"
  class="btn btn-primary fixed bottom-5 right-5 z-40 transition-all duration-300 opacity-0 translate-y-3 pointer-events-none"
>
  <span class="sm:hidden">Poptávka →</span>
  <span class="hidden sm:inline">Nezávazná poptávka →</span>
</a>

<script>
  const cta = document.getElementById('floating-cta');
  const contact = document.getElementById('kontakt');
  let scrolled = false;
  let contactVisible = false;
  const update = () => {
    const show = scrolled && !contactVisible;
    cta.classList.toggle('opacity-0', !show);
    cta.classList.toggle('translate-y-3', !show);
    cta.classList.toggle('pointer-events-none', !show);
    cta.classList.toggle('opacity-100', show);
    cta.classList.toggle('translate-y-0', show);
    cta.tabIndex = show ? 0 : -1;
    cta.setAttribute('aria-hidden', String(!show));
  };
  const onScroll = () => { scrolled = scrollY > innerHeight * 0.6; update(); };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  if (contact) new IntersectionObserver(([e]) => { contactVisible = e.isIntersecting; update(); }).observe(contact);
</script>
