---
// Prohlížeč fotek – otevírá se přes window.openLightbox(fotky, index, popisek)
---
<div id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Fotografie" class="fixed inset-0 z-[100] bg-stone-950/95 items-center justify-center p-4 select-none [&:not([hidden])]:flex">
  <button data-lb="close" class="absolute top-5 right-5 text-stone-300 hover:text-white text-3xl font-body leading-none" aria-label="Zavřít">✕</button>
  <button data-lb="prev" class="absolute left-3 md:left-8 text-stone-300 hover:text-brand-400 text-5xl font-display px-3" aria-label="Předchozí">‹</button>
  <img id="lb-img" alt="" class="max-h-[88vh] max-w-[92vw] object-contain shadow-2xl" />
  <button data-lb="next" class="absolute right-3 md:right-8 text-stone-300 hover:text-brand-400 text-5xl font-display px-3" aria-label="Další">›</button>
  <span id="lb-caption" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-stone-400 font-body text-sm tracking-wider text-center"></span>
</div>

<script>
  const box = document.getElementById('lightbox');
  const img = document.getElementById('lb-img');
  const caption = document.getElementById('lb-caption');
  let list = [];
  let index = 0;
  let label = '';
  let opener = null;

  const show = () => {
    img.src = list[index];
    img.alt = `${label || 'Realizace Šedivák Stavby'} – foto ${index + 1}`;
    caption.textContent = `${label ? `${label} · ` : ''}${index + 1} / ${list.length}`;
  };
  const move = (dir) => { index = (index + dir + list.length) % list.length; show(); };
  const close = () => {
    box.hidden = true;
    document.body.style.overflow = '';
    opener?.focus();
  };

  window.openLightbox = (photos, i, title = '') => {
    list = photos; index = i; label = title;
    opener = document.activeElement;
    show();
    box.hidden = false;
    document.body.style.overflow = 'hidden';
    box.querySelector('[data-lb="close"]').focus();
  };

  box.addEventListener('click', (e) => {
    const action = e.target.closest('[data-lb]')?.dataset.lb;
    if (action === 'prev') move(-1);
    else if (action === 'next') move(1);
    else if (e.target !== img) close();
  });
  addEventListener('keydown', (e) => {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') move(1);
    if (e.key === 'ArrowLeft') move(-1);
  });
</script>
